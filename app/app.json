{
  "expo": {
    "name": "Meesh",
    "slug": "app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/Meesh_icon_1024.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boxofscrapsstudio.meesh",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5c0a0a",
        "foregroundImage": "./assets/images/Meesh_icon_1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "versionCode": 1,
      "package": "com.boxofscrapsstudio.meesh"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Meesh_icon_1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Meesh_icon_1024.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Meesh to access your contacts to find friends and invite them to the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Meesh_icon_1024.png",
          "color": "#c41010"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8829125322462367~6703328775",
          "iosAppId": "ca-app-pub-8829125322462367~7114364063"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8dcfb836-eabc-4e25-b496-832fc5beffca"
      }
    }
  }
}
